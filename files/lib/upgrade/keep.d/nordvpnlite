# nordvpnlite is installed at runtime by /usr/sbin/nordvpnlite-install, not shipped in
# the image, so its files live on the overlay and are preserved here so the VPN works
# straight after a sysupgrade. The image contains none of these paths, so keeping them
# cannot shadow firmware files. /etc/config/nordvpnlite and the update cron entry in
# /etc/crontabs/root are already preserved by the base-files and busybox keep.d lists.
/etc/nordvpnlite/
/usr/sbin/nordvpnlite
/etc/init.d/nordvpnlite
/etc/rc.d/S99nordvpnlite
/etc/rc.d/K01nordvpnlite
/usr/share/rpcd/ucode/nordvpnlite.uc
/usr/share/rpcd/acl.d/luci-app-nordvpnlite.json
/usr/share/luci/menu.d/luci-app-nordvpnlite.json
/www/luci-static/resources/view/nordvpnlite/
